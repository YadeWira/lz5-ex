@@ -375,6 +375,30 @@ int64_t lzbench_lizard_decompress(char *inbuf, size_t insize, char *outbuf, size
 
 
 
+#ifndef BENCH_REMOVE_LZ5
+#include "lz/lz5/lz5.h"
+#include "lz/lz5/lz5hc.h"
+
+/* lz5-ex (the LZ5 1.5.x lineage, not Lizard).
+ * Level 0 is the plain fast path; levels 1..15 are the high-compression
+ * parsers. This mirrors how the lz5 CLI maps its -N option. */
+int64_t lzbench_lz5_compress(char *inbuf, size_t insize, char *outbuf, size_t outsize, codec_options_t *codec_options)
+{
+    if (codec_options->level < 1)
+        return LZ5_compress_default(inbuf, outbuf, (int)insize, (int)outsize);
+    return LZ5_compress_HC(inbuf, outbuf, (int)insize, (int)outsize, codec_options->level);
+}
+
+int64_t lzbench_lz5_decompress(char *inbuf, size_t insize, char *outbuf, size_t outsize, codec_options_t *codec_options)
+{
+    (void)codec_options;
+    return LZ5_decompress_safe(inbuf, outbuf, (int)insize, (int)outsize);
+}
+
+#endif
+
